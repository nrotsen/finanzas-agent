# Copiá este archivo a `.env` y completá los valores reales.
# `.env` está en .gitignore — no se commitea.

# Google Sheets (sheet de gastos del agente personal)
GOOGLE_SHEETS_CREDS_PATH=./creds/service-account.json
GOOGLE_SHEETS_ID=

# Anthropic API
ANTHROPIC_API_KEY=

# Perfil del agente (opcional). Sin esto usa un perfil genérico.
# AGENT_PROFILE_JSON={"owner_name":"Ana","categorias_variables":["comida","transporte"],"categorias_fijas":["alquiler","internet"]}

# wa_ids habilitados, separados por coma (solo lo usa el webhook).
# ALLOWED_SENDERS=5491112345678
